# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- GoHighLevel (Settings > Private Integrations) ---
GHL_API_TOKEN=
GHL_LOCATION_ID=
# LEAVE BLANK for now. Blank = the bot collects the lead's preferred day/time and the team calls
# them. Fill with a GHL calendar ID later to switch on direct booking.
GHL_CALENDAR_ID=

# --- Security ---
# Any long random string. Put the same value in the GHL webhook as header  x-webhook-secret
WEBHOOK_SECRET=

# --- Business details the bot uses in its replies ---
BUSINESS_NAME=
SERVICE_AREA=
TIMEZONE=Australia/Sydney
# Name the bot signs off as if asked who it is (it never claims to be human)
BOT_NAME=the team
